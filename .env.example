# Tekmérion environment variables
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Dataset mode (Flask)
# ---------------------------------------------------------------------------
# synthetic  — development sample (default, safest for tests)
# showroom   — offline portfolio demo (data/showroom/, no secrets required)
# market     — load a processed market artifact (path via TEKMERION_MARKET_FILE)
TEKMERION_DATA_MODE=synthetic
# TEKMERION_MARKET_FILE=data/processed/market/your_artifact.json

# ---------------------------------------------------------------------------
# Grounded generative analysis
# ---------------------------------------------------------------------------
# disabled           — no generation (default, safe)
# fake               — deterministic DEMO output (NOT a real LLM call)
# openai_compatible  — live HTTP provider (requires API key)
TEKMERION_LLM_PROVIDER=disabled
# TEKMERION_LLM_API_KEY=
# TEKMERION_LLM_BASE_URL=https://api.openai.com/v1
# TEKMERION_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Adzuna API (CLI live fetch only — Flask never uses these)
# https://developer.adzuna.com/
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_API_KEY=
