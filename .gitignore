# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local secrets & environment
.env
.env.*
!.env.example
*.pem
credentials.json
secrets/

# Data that should not be committed by default (large or sensitive)
# We keep the small synthetic sample under data/raw/
data/processed/*
!data/processed/.gitkeep
!data/processed/market/
!data/processed/market/.gitkeep

# Live Adzuna snapshots (ephemeral / potentially large) — keep directory
data/raw/real/adzuna/*
!data/raw/real/adzuna/.gitkeep

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/
.grok/

# Local Gold Dataset (Adzuna vacancy text — do not commit)
data/ml/gold/role_family_v1.json
data/ml/gold/local/
data/ml/gold/candidates_unlabeled_v1.json
data/ml/gold/label_session.json
data/ml/gold/_review*.json
data/ml/gold/_all_queue*.json
data/ml/gold/_print_titles.py
data/ml/gold/_find_da.py
.cursor/

# Showroom is versioned (portfolio demo)
!data/showroom/
!data/showroom/**

# Local processed market snapshots (keep dir; prefer showroom for public demo)
data/processed/market/*.json
!data/processed/market/.gitkeep
